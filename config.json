{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 10808,
      "listen": "0.0.0.0",
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "YouTube.com",
            "port": 443,
            "users": [
              {
                "id": "00000000-0000-0000-0000-000000000000",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "YouTube.com",
          "allowInsecure": false
        },
        "wsSettings": {
          "path": "/",
          "headers": {
            "Host": "localhost:22",
            "X-Host-Extra": "example.com",
            "Service": "SSH",
            "ModeX": "Bypass",
            "Upgrade": "websocket",
            "Method": "PATCH"
          }
        }
      }
    }
  ]
}
